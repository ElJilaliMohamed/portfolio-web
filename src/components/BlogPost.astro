---
import speechBalloon from '../collabs/img/titleBalloon.png';
import rippedPaper from '../collabs/img/rippedTaped-paper.png';
import { Image } from 'astro:assets';
const { title, url, description, image } = Astro.props;
---

<div  class="btn-bg">
  <a href=`/portfolio-web${url}` class="orbitron-style">
    <div class="title-comp">
      <Image src={speechBalloon} alt="" format="avif" inferSize class="balloon-img" />
      <p class="title-balloon absolute-center">{title}</p>
    </div>
    <div>
      <img src={image} alt="" format="avif" inferSize class="img-collab" sizes="(min-width: 1100px) 29vw, (min-width: 780px) 40vw, calc(100vw - 56px)" />
      <!-- 256×252, 623×613, 912×898, 1250×1231, 1520×1496, 1740×1713 -->
      <div class="desc-comp">
        <p class="regularText absolute-center">{description}</p>
        <Image src={rippedPaper} alt="" class="ripped-paper" />
      </div>
    </div>
  </a>

  <style>
    .btn-bg {
      background-color: rgb(228, 228, 228);
      padding: 1rem;
      border-radius: 0.6rem;
      margin: 1em 1em 1.4em 0.5em;
      max-width: 100%;
    }
    .img-collab {
      transition: 0.3s;
    }
    .btn-bg:hover .title-comp {
      animation: updown 0.7s infinite alternate;
    }
    .btn-bg:hover .img-collab {
      box-shadow: 0 5px 30px rgb(153, 19, 19);
    }
    .balloon-img {
      position: absolute;
      top: 0;
      display: none;
    }
    .ripped-paper {
      height: auto;
      max-width: 100%;
      z-index: 0;
      display: none;
    }
    a {
      font-weight: 900;
    }
    .desc-comp {
      position: relative;
      padding-top: 1rem;
    }
    .desc {
      font-weight: 500;
    }

    @media (min-width: 48.0625em) {
      .btn-bg {
        max-width: 40%;
      }
    }

    @media (min-width: 67.5625em) {
      .btn-bg {
        background: none;
        width: 29%;
        max-width: none;
      }
      .title-comp {
        padding-top: 12rem;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .absolute-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      }
      .title-balloon {
        max-width: 50%;
        font-size: 1.4rem;
        text-align: center;
        padding-bottom: 1.7rem;
        z-index: 1;
      }
      .desc {
        width: 70%;
        font-size: 1em;
        z-index: 1;
      }
      .balloon-img,
      .ripped-paper {
        display: block;
      }
    }

    @keyframes updown {
      from {
        transform: translateY(0%);
      }
      to {
        transform: translateY(-10%);
      }
    }
  </style>
</div>
