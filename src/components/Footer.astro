---
const platform = ['Instagram', 'Twitter'];
const username = ['mangaka.mozam', 'sanartmo'];
---

<footer>
  <div class="footer-comp">
    <div class="regularText orbitron-style">
      <p>check out more behind the scenes stuff!:</p>
      <ul>
        <li>
          <a href={`https://www.${platform[0]}.com/${username[0]}`} class="footer-link">{platform[0]}</a>!
        </li>
        <li>
          <a href={`https://www.${platform[1]}.com/${username[1]}`} class="footer-link">{platform[1]}</a>!
        </li>
      </ul>
    </div>
    <div class="orbitron-style protected-work">
      <ul>
        <li>
          <div class="rss-style">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-rss-fill" viewBox="0 0 16 16">
              <path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm1.5 2.5c5.523 0 10 4.477 10 10a1 1 0 1 1-2 0 8 8 0 0 0-8-8 1 1 0 0 1 0-2m0 4a6 6 0 0 1 6 6 1 1 0 1 1-2 0 4 4 0 0 0-4-4 1 1 0 0 1 0-2m.5 7a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3"></path>
            </svg>

            <a rel="alternate" class="footer-link" type="application/rss+xml" title="Your Site's Title" href={new URL('/portfolio-web/rss.xml', Astro.site)}>Subscribe to RSS feed</a>
          </div>
        </li>
        <li>
          <p>Projects owned by "Mozam Productions",<br /> it is prohibited to use any of the content for your own personal or commercial use.</p>
        </li>
      </ul>
    </div>
  </div>
</footer>
<style>
  .footer-comp {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: start;
  }
  .protected-work {
    font-size: 1rem;
    font-style: italic;
  }
  .rss-style {
    display: flex;
    align-items: center;
    padding-bottom: 0.7rem;
  }
</style>
