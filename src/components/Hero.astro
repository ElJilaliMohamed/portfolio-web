---
import { Image } from 'astro:assets';
import paperMozam from '../collabs/img/paper-mozam.png';
import mozamPolaroid from '../collabs/img/mozam-polaroid.webp';
---

<div class="hero__img">
  <div class="gsap-hero hero-comp">
    <p class="regularText hero-txt orbitron-style">Art, drawing, designing, coding. Just being clever with concepts on different types of media, especially manga storytelling.</p>
    <Image src={paperMozam} alt="mozam" srcset="" format="avif" inferSize class="paper-mozam" width={600} />
  </div>
  <Image src={mozamPolaroid} alt="mozam" format="avif" inferSize class="gsap-hero mozam" widths={[256, 577, 864, 1120, 1320, 1500, 1660, 1800]} sizes="(min-width: 1000px) 30vw, 80vw" />
</div>
<script src="../scripts/gsap.js"></script>

<style>
  .hero__img {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    background-image: url('../collabs/img/paper-grid-new.png');
    background-repeat: no-repeat;
    background-size: cover;
  }
  .hero-comp {
    position: relative;
  }
  .hero-txt {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .mozam {
    max-width: 80%;
  }

  @media (min-width: 62em) {
    .mozam {
      height: auto;
      max-width: 30%;
    }
  }
</style>
