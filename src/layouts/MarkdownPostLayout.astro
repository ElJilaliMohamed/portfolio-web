---
import BaseLayout from '../layouts/BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title}>
  <div class="content orbitron-style">
    <div class="top-part">
      <img src={frontmatter.image[0].src} alt="" />
      <div class="text">
        <slot />
      </div>
    </div>
    <div class="img-group">
      {frontmatter.image.slice(1).map((img = Astro.props) => <img src={img.src} alt="" />)}
    </div>
  </div>
  <style>
    .content {
      font-weight: 500;
      font-size: 1em;
      padding-inline: 1em;
    }
    .top-part {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      padding: 1rem;
    }
    .text {
      max-width: 100%;
      padding-top: 1em;
      padding-bottom: 1em;
      margin: auto;
    }
    .detail-comp .img-group {
      padding: 4rem 0;
    }
    
    @media (min-width: 48.0625em) {
      .text {
        max-width: 50%;
      }
    }
  </style>
</BaseLayout>
